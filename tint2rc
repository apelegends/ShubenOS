# shubenOS 1.0 taskbar
# 1: panel
rounded = 0
border_width = 1
border_sides = T
background_color = #0d0f1c 92
border_color = #7b2fff 100
# 2: idle task / items
rounded = 6
border_width = 0
background_color = #161926 0
border_color = #000000 0
# 3: active task
rounded = 6
border_width = 0
background_color = #7b2fff 85
border_color = #000000 0
# 4: hover task
rounded = 6
border_width = 0
background_color = #1e2240 100
border_color = #000000 0

panel_items = LTSC
panel_size = 100% 44
panel_position = bottom center horizontal
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
panel_layer = top
wm_menu = 1
panel_dock = 0
strut_policy = follow_size
autohide = 0

launcher_padding = 4 2 6
launcher_background_id = 0
launcher_icon_size = 30
launcher_icon_theme = Papirus-Dark
launcher_item_app = /usr/share/applications/shuben-start.desktop

taskbar_mode = single_desktop
taskbar_padding = 6 0 4
taskbar_background_id = 0
taskbar_name = 0
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 190 36
task_padding = 8 4 6
task_background_id = 2
task_active_background_id = 3
task_iconified_background_id = 2
task_urgent_background_id = 4
task_font_color = #e0e8ff 100
task_active_font_color = #ffffff 100
task_iconified_font_color = #8899bb 100
task_font = Inter 10
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify

systray_padding = 4 4 4
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 22

time1_format = %H:%M
time2_format = %d %b %Y
time1_font = Inter Bold 10
time2_font = Inter 8
clock_font_color = #e0e8ff 100
clock_padding = 10 0
clock_background_id = 0
clock_lclick_command = xfce4-terminal -e "cal -3" --hold
