#!/bin/sh
# shubenOS 1.0 - live-build configuration (Debian 12 "bookworm")
set -e
lb config noauto \
  --distribution bookworm \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --debian-installer none \
  --binary-images iso-hybrid \
  --bootloaders "grub-pc,grub-efi" \
  --bootappend-live "boot=live components quiet locales=en_US.UTF-8" \
  --iso-application "shubenOS 1.0" \
  --iso-publisher "shuben / Apelegends" \
  --iso-volume "shubenOS-1.0" \
  --image-name "shubenOS-1.0" \
  --apt-recommends false \
  --security true --updates true \
  --memtest none \
  --chroot-squashfs-compression-type xz \
  "${@}"
