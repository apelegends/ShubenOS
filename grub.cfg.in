# shubenOS 1.0 boot menu  -  Copyright (c) 2026 shuben / Apelegends
set default=0
set timeout=12

insmod all_video
insmod gfxterm
insmod png
insmod part_gpt
insmod part_msdos
insmod fat
insmod ntfs
insmod chain
if loadfont /boot/grub/fonts/unicode.pf2; then true; elif loadfont /boot/grub/unicode.pf2; then true; fi
set gfxmode=auto
set gfxpayload=keep
terminal_output gfxterm
if background_image /boot/grub/shuben-bg.png; then true; fi
set color_normal=light-cyan/black
set color_highlight=black/cyan
set menu_color_normal=white/black
set menu_color_highlight=black/cyan

menuentry "shubenOS 1.0  -  Start (live)" {
  linux @KERNEL@ boot=live components quiet locales=en_US.UTF-8
  initrd @INITRD@
}
menuentry "shubenOS 1.0  -  Install / Dual-boot  (choose your drive and partition)" {
  linux @KERNEL@ boot=live components quiet locales=en_US.UTF-8 shuben.install
  initrd @INITRD@
}
menuentry "shubenOS 1.0  -  Safe graphics" {
  linux @KERNEL@ boot=live components nomodeset locales=en_US.UTF-8
  initrd @INITRD@
}
menuentry "shubenOS 1.0  -  Run from RAM" {
  linux @KERNEL@ boot=live components toram quiet locales=en_US.UTF-8
  initrd @INITRD@
}
menuentry "Boot Windows / another OS already on this PC" {
  if [ "${grub_platform}" = "efi" ]; then
    search --no-floppy --file --set=root /EFI/Microsoft/Boot/bootmgfw.efi
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
  else
    set root=(hd1)
    chainloader +1
  fi
}
if [ "${grub_platform}" = "efi" ]; then
  menuentry "UEFI firmware settings" { fwsetup }
fi
menuentry "About shubenOS 1.0" {
  echo "shubenOS 1.0  -  Copyright (c) 2026 shuben / Apelegends. All rights reserved."
  echo "Built on Debian GNU/Linux 12."
  sleep --interruptible 8
}
