* {
  bg: #0d0f1cf2; bg-alt: #161926; fg: #e0e8ff; accent: #00d4ff; accent2: #7b2fff;
  background-color: transparent; text-color: @fg;
}
window {
  location: south west; anchor: south west;
  x-offset: 10px; y-offset: -54px;
  width: 520px; background-color: @bg;
  border: 1px; border-color: @accent2; border-radius: 12px; padding: 14px;
}
mainbox { children: [inputbar, listview]; spacing: 12px; }
inputbar { background-color: @bg-alt; padding: 10px 12px; border-radius: 8px; spacing: 8px; children: [prompt, entry]; }
prompt { text-color: @accent; }
listview { lines: 9; columns: 1; spacing: 4px; scrollbar: false; }
element { padding: 8px 10px; border-radius: 8px; spacing: 10px; }
element selected.normal { background-color: @accent2; text-color: #ffffff; }
element-icon { size: 28px; }
